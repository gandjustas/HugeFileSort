<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net11 вернём после GA: inbox-zstd + runtime-async. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- zstd из BCL .NET 11; до GA net11 — backport с теми же типами System.IO.Compression.Zstandard*. -->
    <PackageReference Include="SystemIOCompression.Zstandard.Backporting" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="DotMake.CommandLine" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

</Project>
